APP_NAME=EA-Express
# Esempio locale: in produzione impostare production, URL HTTPS e segreti dedicati.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
# SQLite usa database/database.sqlite: creare il file prima delle migrazioni locali.
# Per MySQL impostare un database dedicato.
# DB_DATABASE=ea_express
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME="${APP_NAME}"

# VITE_* sono pubbliche: non inserire credenziali o segreti.


CUSTOMER_FRONTEND_URL=http://localhost:5173
CUSTOMER_ALLOWED_ORIGINS=http://localhost:5173

PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_URL=
PRIVACY_LEGAL_REVIEWED=false

# 30 giorni; non cambia la durata delle sessioni ordinarie.
CUSTOMER_REMEMBER_MINUTES=43200

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http


ORDER_MAIL_ENABLED=false


BACKUP_ENABLED=false
BACKUP_MODE=offsite
BACKUP_KEY_FILE=
BACKUP_KEY=
BACKUP_OFFSITE_PATH=
BACKUP_RETENTION_DAYS=30
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL_RESTORE_IMAGE=mysql:8.4


AUTH_SECURITY_STORE=database
AUTH_SECURITY_LOCK_SECONDS=30
AUTH_ACCOUNT_WINDOW_SECONDS=3600
AUTH_ACCOUNT_MAX_FAILURES=10
AUTH_ACCOUNT_SUSPENSION_SECONDS=900
AUTH_ACCOUNT_SHORT_WINDOW_SECONDS=900
AUTH_ACCOUNT_SHORT_MAX_FAILURES=5
AUTH_DELAY_THIRD=10
AUTH_DELAY_FOURTH=30
AUTH_DELAY_FIFTH=60
AUTH_DELAY_SUBSEQUENT=300
AUTH_IP_ATTEMPTS=20
AUTH_IP_WINDOW_SECONDS=600
AUTH_IP_HARD_ATTEMPTS=60
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_RESENDS=3
AUTH_OTP_WINDOW_SECONDS=900
AUTH_OTP_ACCOUNT_ATTEMPTS=10
AUTH_OTP_IP_ATTEMPTS=30
AUTH_OTP_IP_SENDS=15
AUTH_GLOBAL_ATTEMPTS=100
AUTH_GLOBAL_WINDOW_SECONDS=60
AUTH_DISTINCT_ACCOUNTS=10
AUTH_DISTINCT_IPS=6
AUTH_GLOBAL_FAILURES=50
AUTH_GLOBAL_OTP_REQUESTS=30
AUTH_RATE_LIMIT_HITS=10
AUTH_PATTERN_WINDOW_SECONDS=600
AUTH_ALERT_COOLDOWN_SECONDS=900
AUTH_CONTEXT_SECONDS=604800

AUTH_ALERT_QUEUE_CONNECTION=database
AUTH_ALERT_QUEUE=security
AUTH_LOG_RETENTION_DAYS=14
AUTH_PASSWORD_MIN=12

AUTH_PASSWORD_BREACH_CHECK=true
AUTH_PASSWORD_CHECK_TIMEOUT=5

AUTH_TURNSTILE_ENABLED=false
AUTH_TURNSTILE_ALWAYS=false
AUTH_TURNSTILE_SITE_KEY=
AUTH_TURNSTILE_SECRET_KEY=
AUTH_TURNSTILE_HOSTNAMES=
AUTH_TURNSTILE_TIMEOUT_SECONDS=5


TRUSTED_PROXIES=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache
AUTH_SENSITIVE_ACCOUNT_ATTEMPTS=5
AUTH_SENSITIVE_IP_ATTEMPTS=20
AUTH_SENSITIVE_WINDOW_SECONDS=600

AUTH_STAFF_DEVICE_ENABLED=true
AUTH_STAFF_DEVICE_TTL_SECONDS=604800
AUTH_TRUSTED_RIDER_ENABLED=true
AUTH_TRUSTED_RIDER_TTL_SECONDS=2592000
# Dispositivo cliente verificato con OTP: 180 giorni, poi nuova verifica.
AUTH_TRUSTED_CUSTOMER_ENABLED=true
AUTH_TRUSTED_CUSTOMER_TTL_SECONDS=15552000
AUTH_STAFF_DEVICE_ATTEMPTS=3
AUTH_STAFF_DEVICE_WINDOW_SECONDS=900
AUTH_DISTINCT_NETWORKS=3
AUTH_MISSING_ACCOUNTS=10

# Usare un SMTP locale (es. Mailpit); log è un override consentito solo in sviluppo.
# In produzione usare smtp per entrambi i mailer e verificare la consegna degli OTP.
AUTH_OTP_MAILER=smtp
AUTH_ALERT_DELIVERY_COOLDOWN_SECONDS=60

# Sessioni: connessione opzionale per database/Redis e tabella personalizzabile.
SESSION_CONNECTION=null
SESSION_TABLE=sessions
# Omettere SESSION_SECURE_COOKIE: il codice usa true in produzione e false in locale.
# Non aggiungere una riga vuota o false nella configurazione di produzione.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# In produzione: APP_ENV=production, APP_DEBUG=false, HTTPS e SESSION_SECURE_COOKIE=true.
REDIS_DB=0
REDIS_CACHE_DB=1

# Backup: percorsi privati; il ripristino MySQL di verifica usa Docker isolato.
BACKUP_PATH=storage/app/private/backups
BACKUP_DOCKER=docker

# Worker: timeout del worker inferiore al retry_after della connessione.
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=120
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
